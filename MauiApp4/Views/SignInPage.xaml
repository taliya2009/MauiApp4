<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp4.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp4.ViewModels"
    x:DataType="views:SignInPageViewModel"
    Title="SignInPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="1.0" Color="Purple" />
            <GradientStop Offset="0.5" Color="#3a7bd5" />
            <GradientStop Offset="0.0" Color="LightCyan" />

        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Border
            Padding="10"
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Entry
                FontSize="18"
                Keyboard="Email"
                Placeholder="Email"
                ReturnType="Go"
                Text="{Binding UserName}"
                TextColor="Wheat" />
        </Border>

        <Border
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Grid
                Padding="10"
                ColumnDefinitions="*,Auto"
                VerticalOptions="Center">
                <Entry
                    BackgroundColor="Transparent"
                    FontSize="18"
                    IsPassword="{Binding EntryAsPassword}"
                    Placeholder="סיסמה"
                    Text="{Binding UserPassword}"
                    TextColor="Wheat"
                    VerticalOptions="Center" />
                <Button
                    Margin="5,0,0,0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ShowPasswordCommand}"
                    FontFamily="MaterialIcons"
                    FontSize="24"
                    HorizontalOptions="End"
                    Text="{Binding IconPasswordButton}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  התחברות  כפתור כניסה  -->
        <Button
            Clicked="OnSignInButtonClick"
            CornerRadius="8"
            FontSize="18"
            HeightRequest="50"
            IsEnabled="{Binding IsSignInButtonEnabled}"
            Text="חיבור"
            TextColor="White" />

        <!--  שגיאה  -->
        <Label
            FontSize="45"
            HorizontalTextAlignment="Center"
            IsVisible="{Binding IsSignInMessageVisible}"
            Text="{Binding MessageText}"
            TextColor="{Binding MessageColor}" />

    </VerticalStackLayout>
</ContentPage>
