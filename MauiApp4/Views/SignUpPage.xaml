<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp4.Views.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp4.Views"
    Title="SignUpPage"
    x:DataType="views:SignUpPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#004FF9" />
            <GradientStop Offset="1.0" Color="#FFF94C" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid ColumnDefinitions="*, 8*,*" RowDefinitions="*, 4*,*">
        <HorizontalStackLayout
            Grid.Column="1"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!--  כותרת  -->
            <Label
                FontSize="24"
                Text="Create Account"
                TextColor="White" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="1">

            <!--  שדה שם פרטי  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Placeholder="First Name"
                    Text=""
                    TextColor="Wheat" />
            </Border>
            <!--  שדה שם משפחה  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Placeholder="Last Name"
                    Text=""
                    TextColor="Wheat" />
            </Border>
            <!--  שדה דואל  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Keyboard="Email"
                    Placeholder="Email"
                    Text=""
                    TextColor="Wheat" />
            </Border>
            <!--  שדה סיסמה  -->
            <Border
                Margin="0,0,0,10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Grid
                    Padding="10"
                    ColumnDefinitions="*,Auto"
                    VerticalOptions="Center">
                    <Entry
                        BackgroundColor="Transparent"
                        FontSize="18"
                        IsPassword="True"
                        Placeholder="Password"
                        Text=""
                        TextColor="Wheat"
                        VerticalOptions="Center" />
                    <Button
                        Margin="5,0,0,0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding ShowPasswordCommand}"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        HorizontalOptions="End"
                        Text="{Binding PasswordIconCode}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Already have an account?  -->
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">

                <Label
                    Margin="14,0,0,0"
                    FontSize="16"
                    Text="Already have an account?"
                    TextColor="White"
                    VerticalTextAlignment="Center" />

                <Button
                    BackgroundColor="Transparent"
                    FontSize="16"
                    Text="SignUp"
                    TextColor="BlueViolet" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>